<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Speedy - Servizio di consegna cibo a domicilio veloce e sicuro">
    <title><%= title || 'Speedy - Consegna a Domicilio' %></title>
    <link rel="icon" href="/images/Icon.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/layout.css">
    <link rel="stylesheet" href="/stylesheets/ui-components.css">
    <link rel="stylesheet" href="/stylesheets/business-components.css">
    <link rel="stylesheet" href="/stylesheets/pages.css">
</head>
<body>
<div class="site-wrapper">
    <%- include('partials/navbar') %>
    
    <main class="site-main">
        <!-- HERO SECTION -->
        <section class="hero-section">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8 hero-content text-center">
                        <span class="hero-badge">
                            <i class="bi bi-lightning-charge-fill me-1"></i>Consegna rapida in tutta la città
                        </span>
                        <h1 class="display-3 fw-bold mb-4">
                            Il cibo che ami,<br>consegnato con <span class="text-gradient">Speedy</span>
                        </h1>
                        <p class="lead mb-5 mx-auto" style="max-width: 560px;">
                            Ordina dai migliori ristoranti della città con pochi clic. 
                            Qualità, velocità e comodità a portata di mano.
                        </p>
                        
                        <!-- Barra di ricerca -->
                        <div class="search-container mx-auto" style="max-width: 600px;">
                            <div class="hero-search-box">
                                <i class="bi bi-search search-icon"></i>
                                <input type="text" id="heroSearch" class="form-control" 
                                       placeholder="Cerca ristoranti o piatti..." 
                                       aria-label="Ricerca ristoranti">
                                <button class="btn btn-primary" id="heroSearchBtn" type="button">
                                    Cerca
                                </button>
                            </div>
                        </div>
                        
                        <!-- Statistiche -->
                        <div class="hero-stats mt-5">
                            <div class="hero-stat-item">
                                <span class="hero-stat-value"><%= restaurants.length %>+</span>
                                <span class="hero-stat-label">Ristoranti</span>
                            </div>
                            <div class="hero-stat-divider"></div>
                            <div class="hero-stat-item">
                                <span class="hero-stat-value">24/7</span>
                                <span class="hero-stat-label">Disponibilità</span>
                            </div>
                            <div class="hero-stat-divider"></div>
                            <div class="hero-stat-item">
                                <span class="hero-stat-value">30 min</span>
                                <span class="hero-stat-label">Consegna media</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CATEGORIE CUCINE -->
        <section class="cuisines-section">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="section-title">Esplora per categoria</h2>
                    <p class="section-subtitle text-muted">Scegli tra le nostre cucine e trova il piatto perfetto per te</p>
                </div>
                <div class="cuisine-grid">
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/Pizza.png" alt="Pizza">
                        </figure>
                        <h3 class="cuisine-label">Pizza</h3>
                    </a>
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/sushi.png" alt="Sushi">
                        </figure>
                        <h3 class="cuisine-label">Sushi</h3>
                    </a>
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/Hamburger.png" alt="Hamburger">
                        </figure>
                        <h3 class="cuisine-label">Hamburger</h3>
                    </a>
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/Italiano.png" alt="Italiano">
                        </figure>
                        <h3 class="cuisine-label">Italiano</h3>
                    </a>
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/Cinese.png" alt="Cinese">
                        </figure>
                        <h3 class="cuisine-label">Cinese</h3>
                    </a>
                    <a href="/restaurants" class="cuisine-card-pro">
                        <figure class="cuisine-img-pro">
                            <img src="/images/Dolci.png" alt="Dolci">
                        </figure>
                        <h3 class="cuisine-label">Dolci</h3>
                    </a>
                </div>
            </div>
        </section>

        <!-- RISTORANTI IN EVIDENZA -->
        <section class="featured-restaurants py-5">
            <div class="container">
                <div class="d-flex justify-content-between align-items-end mb-5">
                    <div>
                        <h2 class="section-title mb-1">Ristoranti in evidenza</h2>
                        <p class="text-muted mb-0">I più amati dai nostri utenti</p>
                    </div>
                    <a href="/restaurants" class="btn btn-outline-primary">
                        Vedi tutti <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                
                <div class="row g-4">
                    <% if (restaurants && restaurants.length > 0) { %>
                        <% restaurants.slice(0, 6).forEach(restaurant => { %>
                            <div class="col-md-6 col-lg-4">
                                <article class="card restaurant-card h-100">
                                    <div class="position-relative">
                                        <img src="<%= restaurant.image_url || '/images/placeholder-restaurant.jpg' %>" 
                                             class="card-img-top img-card-cover"
                                             alt="<%= restaurant.name %>"
                                             loading="lazy"
                                             onerror="this.src='/images/placeholder-restaurant.jpg'">
                                        <% if (restaurant.status === 'active') { %>
                                            <span class="badge bg-success position-absolute top-0 end-0 m-3">
                                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>Aperto
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-danger position-absolute top-0 end-0 m-3">Chiuso</span>
                                        <% } %>
                                    </div>
                                    <div class="card-body d-flex flex-column">
                                        <h3 class="card-title h5 fw-bold mb-2">
                                            <a href="/restaurant/<%= restaurant.id %>" class="text-decoration-none text-dark stretched-link">
                                                <%= restaurant.name %>
                                            </a>
                                        </h3>
                                        <p class="card-text text-muted small flex-grow-1">
                                            <%= (restaurant.description || '').substring(0, 100) %><%= (restaurant.description || '').length > 100 ? '...' : '' %>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                                            <div class="rating">
                                                <i class="bi bi-star-fill text-warning"></i>
                                                <span class="fw-bold"><%= (restaurant.avg_rating || 0).toFixed(1) %></span>
                                                <span class="text-muted small">(<%= restaurant.review_count || 0 %>)</span>
                                            </div>
                                            <span class="btn btn-sm btn-primary">
                                                Ordina ora <i class="bi bi-arrow-right ms-1"></i>
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-12 text-center py-5">
                            <i class="bi bi-shop text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3 mb-0">Nessun ristorante disponibile al momento</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- COME FUNZIONA -->
        <section class="how-it-works">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="section-title">Come funziona</h2>
                    <p class="section-subtitle text-muted">Ordinare non è mai stato così semplice</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <article class="step-card">
                            <div class="step-number">1</div>
                            <div class="step-icon">
                                <i class="bi bi-search"></i>
                            </div>
                            <h3 class="step-title">Cerca</h3>
                            <p class="step-desc">Trova il ristorante perfetto per te tra quelli disponibili nella tua zona</p>
                        </article>
                    </div>
                    <div class="col-md-4">
                        <article class="step-card">
                            <div class="step-number">2</div>
                            <div class="step-icon">
                                <i class="bi bi-cart-check"></i>
                            </div>
                            <h3 class="step-title">Ordina</h3>
                            <p class="step-desc">Esplora il menu, scegli i tuoi piatti preferiti e conferma l'ordine</p>
                        </article>
                    </div>
                    <div class="col-md-4">
                        <article class="step-card">
                            <div class="step-number">3</div>
                            <div class="step-icon">
                                <i class="bi bi-bag-check"></i>
                            </div>
                            <h3 class="step-title">Ricevi</h3>
                            <p class="step-desc">Rilassati e ricevi il tuo ordine direttamente a casa tua in pochi minuti</p>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA SECTION -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card text-center">
                    <h2 class="cta-title">Sei un ristoratore?</h2>
                    <p class="cta-desc">Unisciti a Speedy e raggiungi migliaia di nuovi clienti nella tua città</p>
                    <a href="/register" class="btn btn-light btn-lg cta-btn">
                        Registra il tuo ristorante <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
<script src="/javascripts/client.js"></script>
</body>
</html>