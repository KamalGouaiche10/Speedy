<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/layout.css">
    <link rel="stylesheet" href="/stylesheets/ui-components.css">
    <link rel="stylesheet" href="/stylesheets/business-components.css">
    <link rel="stylesheet" href="/stylesheets/pages.css">
</head>
<body>
    
    <%- include('partials/navbar') %>
    
    <section class="py-5 bg-light">
        <div class="container">
            <div class="row align-items-center mb-4">
                <div class="col-md-6">
                    <h1 class="fw-bold">
                        Tutti i Ristoranti
                    </h1>
                    <p class="text-muted mb-0"><%= restaurants.length %> ristorante/i trovato/i
                        <% if (locals.nearby) { %>
                            <span class="badge bg-info text-dark ms-2">Risultati nelle vicinanze</span>
                        <% } %>
                    </p>
                </div>
                <div class="col-md-6">
                    <form action="/restaurants" method="GET" class="input-group">
                        <input type="text" class="form-control" name="q" id="search-input"
                               placeholder="Cerca ristorante..." value="<%= locals.query || '' %>">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Filtri -->
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Ordina per:</label>
                            <select class="form-select" id="sort-select">
                                <option value="name">Nome (A-Z)</option>
                                <option value="rating">Valutazione</option>
                                <option value="recent">Più recenti</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Valutazione minima:</label>
                            <select class="form-select" id="rating-filter">
                                <option value="0">Tutte</option>
                                <option value="3">3+ stelle</option>
                                <option value="4">4+ stelle</option>
                                <option value="4.5">4.5+ stelle</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Cerca nelle vicinanze:</label>
                            <button class="btn btn-outline-primary w-100" id="nearby-btn">
                                <i class="bi bi-geo-alt me-2"></i>
                                Usa la mia posizione
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lista ristoranti -->
            <% if (locals.error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>
            
            <div id="restaurants-list" class="row">
                <% if (restaurants && restaurants.length > 0) { %>
                    <% restaurants.forEach(restaurant => { %>
                        <div class="col-md-6 col-lg-4 mb-4 fade-in-up restaurant-item" 
                             data-rating="<%= restaurant.avg_rating || 0 %>"
                             data-name="<%= restaurant.name %>"
                             data-date="<%= restaurant.created_at %>">
                            <div class="restaurant-card" onclick="window.location='/restaurant/<%= restaurant.id %>'">
                                <div class="position-relative">
                                    <img src="<%= restaurant.image_url || '/images/placeholder-restaurant.jpg' %>" 
                                         class="restaurant-card-img" 
                                         alt="<%= restaurant.name %>"
                                         onerror="this.src='/images/placeholder-restaurant.jpg'">
                                    <% if (restaurant.status === 'active') { %>
                                        <span class="badge bg-success badge-status">Aperto</span>
                                    <% } else { %>
                                        <span class="badge bg-danger badge-status">Chiuso</span>
                                    <% } %>
                                </div>
                                <div class="restaurant-card-body">
                                    <h3 class="restaurant-name"><%= restaurant.name %></h3>
                                    <p class="restaurant-description">
                                        <%= restaurant.description || 'Nessuna descrizione disponibile' %>
                                    </p>
                                    <div class="restaurant-info">
                                        <div class="rating">
                                            <i class="bi bi-star-fill"></i>
                                            <span><%= (restaurant.avg_rating || 0).toFixed(1) %></span>
                                            <span class="text-muted ms-1">(<%= restaurant.review_count || 0 %>)</span>
                                        </div>
                                        <div class="delivery-info">
                                            <i class="bi bi-geo-alt"></i>
                                            <%= (restaurant.address || 'N/A').substring(0, 20) %>...
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-12 text-center py-5" id="empty-state">
                        <i class="bi bi-inbox text-muted icon-xxl"></i>
                        <h3 class="mt-4 text-muted">Nessun ristorante trovato</h3>
                        <p class="text-muted">Prova a modificare i filtri di ricerca</p>
                    </div>
                <% } %>
            </div>
        </div>
    </section>
    
    <%- include('partials/footer') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/client.js"></script>
</body>
</html>