<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/layout.css">
    <link rel="stylesheet" href="/stylesheets/ui-components.css">
    <link rel="stylesheet" href="/stylesheets/business-components.css">
    <link rel="stylesheet" href="/stylesheets/pages.css">
</head>
<body>
    
    <%- include('partials/navbar') %>
    
    <!-- Restaurant Header -->
    <section class="bg-light py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <img src="<%= restaurant.image_url || '/images/placeholder-restaurant.jpg' %>" 
                         class="img-fluid rounded shadow" alt="<%= restaurant.name %>"
                         onerror="this.src='/images/placeholder-restaurant.jpg'">
                </div>
                <div class="col-md-9">
                    <h1 class="fw-bold mb-2"><%= restaurant.name %></h1>
                    <p class="text-muted mb-3"><%= restaurant.description || '' %></p>
                    <div class="d-flex gap-4 flex-wrap">
                        <div>
                            <i class="bi bi-star-fill text-warning"></i>
                            <strong><%= (restaurant.avg_rating || 0).toFixed(1) %></strong>
                            <span class="text-muted">(<%= restaurant.review_count || 0 %> recensioni)</span>
                        </div>
                        <div>
                            <i class="bi bi-geo-alt text-danger"></i>
                            <%= restaurant.address || 'Indirizzo non disponibile' %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Menu Section -->
    <section class="py-5">
        <div class="container">
            <div class="row">
                <!-- Menu Items -->
                <div class="col-lg-8">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-bold mb-0">
                            <i class="bi bi-menu-button-wide text-primary me-2"></i>
                            Menù
                        </h2>
                        <input type="text" class="form-control w-50" id="search-menu" 
                               placeholder="Cerca piatto...">
                    </div>

                    <div id="menu-items" class="row">
                        <% if (menuItems && menuItems.length > 0) { %>
                            <% menuItems.forEach(item => { %>
                                <div class="col-md-6 mb-4 menu-item" 
                                     data-name="<%= item.name.toLowerCase() %>"
                                     data-category="<%= (item.category || '').toLowerCase() %>">
                                    <div class="menu-card <%= !item.available ? 'opacity-50' : '' %>">
                                        <div class="position-relative">
                                            <img src="<%= item.image_url || '/images/placeholder-dish.jpg' %>" 
                                                 class="menu-card-img" alt="<%= item.name %>"
                                                 onerror="this.src='/images/placeholder-dish.jpg'">
                                            <% if (!item.available) { %>
                                                <span class="badge bg-warning position-absolute top-0 end-0 m-2">Non disponibile</span>
                                            <% } %>
                                            <% if (item.category) { %>
                                                <span class="badge bg-primary position-absolute top-0 start-0 m-2"><%= item.category %></span>
                                            <% } %>
                                        </div>
                                        <div class="menu-card-body">
                                            <h4 class="menu-item-name"><%= item.name %></h4>
                                            <p class="menu-item-description">
                                                <%= item.description || 'Nessuna descrizione' %>
                                            </p>
                                            <div class="menu-item-footer">
                                                <span class="menu-item-price">€ <%= parseFloat(item.price).toFixed(2) %></span>
                                                <% if (item.available) { %>
                                                    <button class="btn btn-primary btn-sm add-to-cart" 
                                                            data-id="<%= item.id %>"
                                                            data-name="<%= item.name %>"
                                                            data-price="<%= item.price %>">
                                                        <i class="bi bi-cart-plus me-1"></i> Aggiungi
                                                    </button>
                                                <% } else { %>
                                                    <button class="btn btn-secondary btn-sm" disabled>
                                                        Non disponibile
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="col-12 text-center py-5">
                                <i class="bi bi-inbox text-muted icon-xl"></i>
                                <p class="text-muted mt-3">Nessun piatto disponibile</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Cart Sidebar -->
                <div class="col-lg-4">
                    <div class="card shadow-sm sticky-top sticky-cart">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-cart3 me-2"></i>
                                Carrello (<span id="cart-count">0</span>)
                            </h5>
                        </div>
                        <div class="card-body" id="cart-items">
                            <div class="text-center text-muted py-4">
                                <i class="bi bi-cart-x icon-lg"></i>
                                <p class="mt-2">Il carrello è vuoto</p>
                            </div>
                        </div>
                        <div class="card-footer d-none" id="cart-footer">
                            <div class="d-flex justify-content-between mb-3">
                                <strong>Totale:</strong>
                                <strong class="text-success" id="cart-total">€ 0.00</strong>
                            </div>
                            <button class="btn btn-success w-100" id="checkout-btn" 
                                    data-restaurant-id="<%= restaurant.id %>">
                                <i class="bi bi-check-circle me-2"></i>
                                Procedi all'ordine
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

        <!-- Reviews Section -->
    <section class="py-5 bg-light">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-chat-quote text-primary me-2"></i>
                    Recensioni
                </h3>
                <% if (isAuthenticated && user.role === 'customer') { %>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#reviewModal">
                        <i class="bi bi-star me-2"></i>
                        Lascia una recensione
                    </button>
                <% } %>
            </div>
            
            <% if (reviews && reviews.length > 0) { %>
                <% reviews.forEach(review => { %>
                    <div class="card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong><%= review.user_name %></strong>
                                    <div class="text-warning">
                                        <% for (let i = 0; i < review.rating; i++) { %>★<% } %>
                                        <% for (let i = review.rating; i < 5; i++) { %>☆<% } %>
                                    </div>
                                </div>
                                <small class="text-muted">
                                    <%= new Date(review.created_at).toLocaleDateString('it-IT') %>
                                </small>
                            </div>
                            <p class="mb-0"><%= review.comment || '' %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center text-muted py-4">
                    <i class="bi bi-chat icon-lg"></i>
                    <p class="mt-2">Nessuna recensione disponibile</p>
                    <% if (isAuthenticated && user.role === 'customer') { %>
                        <p class="small">Sii il primo a lasciare una recensione!</p>
                    <% } %>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Modal Recensione -->
    <% if (isAuthenticated && user.role === 'customer') { %>
    <div class="modal fade" id="reviewModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-star me-2"></i>
                        Lascia una recensione
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="review-form">
                        <div class="mb-3 text-center">
                            <label class="form-label fw-bold d-block mb-3">Valutazione *</label>
                            <div class="star-rating" id="star-rating">
                                <i class="bi bi-star fs-2 star" data-rating="1"></i>
                                <i class="bi bi-star fs-2 star" data-rating="2"></i>
                                <i class="bi bi-star fs-2 star" data-rating="3"></i>
                                <i class="bi bi-star fs-2 star" data-rating="4"></i>
                                <i class="bi bi-star fs-2 star" data-rating="5"></i>
                            </div>
                            <input type="hidden" id="rating-value" value="0">
                            <small class="text-danger d-none" id="rating-error">Seleziona una valutazione</small>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Commento (opzionale)</label>
                            <textarea class="form-control" id="review-comment" rows="4" 
                                    placeholder="Racconta la tua esperienza..."></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Annulla
                    </button>
                    <button type="submit" class="btn btn-primary" form="review-form">
                        <i class="bi bi-check-circle me-2"></i>Invia Recensione
                    </button>
                </div>
            </div>
        </div>
    </div>
    <% } %>
    
    <%- include('partials/footer') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/client.js"></script>
    <script src="/javascripts/reviews.js"></script>
</body>
</html>