<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/base.css">
    <link rel="stylesheet" href="/stylesheets/layout.css">
    <link rel="stylesheet" href="/stylesheets/ui-components.css">
    <link rel="stylesheet" href="/stylesheets/business-components.css">
    <link rel="stylesheet" href="/stylesheets/pages.css">
</head>
<body>
    
    <%- include('partials/navbar') %>
    
    <!-- Dashboard Header -->
    <section class="dashboard-header">
        <div class="container">
            <h1 class="fw-bold mb-2">
                <i class="bi bi-speedometer2 me-2"></i>
                Dashboard Ristoratore
            </h1>
            <p class="mb-0">Benvenuto, <%= user.name %>!</p>
        </div>
    </section>

    <!-- Main Dashboard -->
    <section class="py-5">
        <div class="container">
            <!-- Statistiche -->
            <div class="row mb-5">
                <div class="col-md-3 mb-4">
                    <div class="stat-card">
                        <i class="bi bi-shop stat-icon text-primary"></i>
                        <div class="stat-value"><%= restaurants.length %></div>
                        <div class="stat-label">Ristoranti</div>
                    </div>
                </div>
                <div class="col-md-3 mb-4">
                    <div class="stat-card">
                        <i class="bi bi-receipt stat-icon text-success"></i>
                        <div class="stat-value" id="stat-orders">0</div>
                        <div class="stat-label">Ordini ricevuti</div>
                    </div>
                </div>
                <div class="col-md-3 mb-4">
                    <div class="stat-card">
                        <i class="bi bi-clock-history stat-icon text-warning"></i>
                        <div class="stat-value" id="stat-pending">0</div>
                        <div class="stat-label">Ordini in attesa</div>
                    </div>
                </div>
                <div class="col-md-3 mb-4">
                    <div class="stat-card">
                        <i class="bi bi-star stat-icon text-warning"></i>
                        <div class="stat-value" id="stat-rating">-</div>
                        <div class="stat-label">Valutazione media</div>
                    </div>
                </div>
            </div>

            <% if (locals.error) { %>
                <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <!-- Tab Navigation -->
            <ul class="nav nav-tabs mb-4" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#orders-tab">
                        Ordini
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#restaurants-tab">
                        <i class="bi bi-shop me-2"></i>Ristoranti
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#menu-tab">
                        <i class="bi bi-menu-button-wide me-2"></i>Menù
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content">
                
                <!-- ORDINI TAB -->
                <div class="tab-pane fade show active" id="orders-tab">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0">
                            <i class="bi bi-receipt-cutoff me-2 text-primary"></i>
                            Ordini ricevuti
                        </h3>
                        <select class="form-select w-auto" id="restaurant-select">
                            <option value="">Seleziona ristorante...</option>
                            <% restaurants.forEach(r => { %>
                                <option value="<%= r.id %>"><%= r.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div id="orders-list">
                        <p class="text-muted">Seleziona un ristorante per visualizzare gli ordini</p>
                    </div>
                </div>

                <!-- RISTORANTI TAB -->
                <div class="tab-pane fade" id="restaurants-tab">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0">
                            <i class="bi bi-shop me-2 text-primary"></i>
                            Ristoranti
                        </h3>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#restaurantModal">
                            <i class="bi bi-plus-circle me-2"></i>Aggiungi Ristorante
                        </button>
                    </div>
                    
                    <% if (restaurants && restaurants.length > 0) { %>
                        <div class="row">
                            <% restaurants.forEach(r => { %>
                                <div class="col-md-6 mb-4">
                                    <div class="card shadow-sm">
                                        <img src="<%= r.image_url || '/images/placeholder-restaurant.jpg' %>" 
                                             class="card-img-top restaurant-card-img"
                                             onerror="this.src='/images/placeholder-restaurant.jpg'">
                                        <div class="card-body">
                                            <h5 class="card-title"><%= r.name %></h5>
                                            <p class="card-text text-muted"><%= r.description || '' %></p>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="badge bg-<%= r.status === 'active' ? 'success' : 'danger' %>">
                                                    <%= r.status === 'active' ? 'Attivo' : 'Bloccato' %>
                                                </span>
                                                <div>
                                                    <button class="btn btn-sm btn-outline-primary me-2 btn-edit-restaurant" 
                                                            data-id="<%= r.id %>">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-danger btn-delete-restaurant" 
                                                            data-id="<%= r.id %>">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="bi bi-shop text-muted empty-state-icon"></i>
                            <p class="text-muted mt-3">Non hai ancora ristoranti. Creane uno!</p>
                        </div>
                    <% } %>
                </div>

                <!-- MENÙ TAB -->
                <div class="tab-pane fade" id="menu-tab">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold mb-0">
                            Menù
                        </h3>
                        <button class="btn btn-primary" id="add-menu-btn">
                            <i class="bi bi-plus-circle me-2"></i>Aggiungi Piatto
                        </button>
                    </div>
                    <div id="menu-list">
                        <p class="text-muted">Seleziona un ristorante nella sezione ordini</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Modal Ristorante -->
        <div class="modal fade" id="restaurantModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Aggiungi Ristorante</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="restaurant-form">
                            <input type="hidden" id="restaurant-id">
                            <div class="mb-3">
                                <label class="form-label">Nome *</label>
                                <input type="text" class="form-control" id="restaurant-name" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descrizione</label>
                                <textarea class="form-control" id="restaurant-description" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Indirizzo *</label>
                                <input type="text" class="form-control" id="restaurant-address" required>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Latitudine</label>
                                    <input type="number" step="any" class="form-control" id="restaurant-lat">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Longitudine</label>
                                    <input type="number" step="any" class="form-control" id="restaurant-lng">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">URL Immagine</label>
                                <input type="url" class="form-control" id="restaurant-image">
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="button" class="btn btn-primary" onclick="saveRestaurant()">Salva</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="menuItemModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="menuItemModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>
                        Aggiungi Piatto
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="menu-item-form">
                        <input type="hidden" id="menu-item-id">
                        
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Nome Piatto *</label>
                                <input type="text" class="form-control" id="menu-item-name" 
                                    placeholder="Es: Pizza Margherita" required>
                            </div>
                            
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Prezzo (€) *</label>
                                <input type="number" step="0.01" min="0" class="form-control" 
                                    id="menu-item-price" placeholder="0.00" required>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Descrizione</label>
                            <textarea class="form-control" id="menu-item-description" rows="3"
                                    placeholder="Descrivi il piatto, ingredienti, allergeni..."></textarea>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Categoria</label>
                                <select class="form-select" id="menu-item-category">
                                    <option value="Antipasti"> Antipasti</option>
                                    <option value="Primi">Primi</option>
                                    <option value="Secondi">Secondi</option>
                                    <option value="Pizze">Pizze</option>
                                    <option value="Panini">Panini</option>
                                    <option value="Dessert">Dessert</option>
                                    <option value="Bevande">Bevande</option>
                                </select>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Disponibilità</label>
                                <div class="form-check form-switch mt-2">
                                    <input type="checkbox" class="form-check-input" 
                                        id="menu-item-available" checked>
                                    <label class="form-check-label" for="menu-item-available">
                                        Disponibile per gli ordini
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">URL Immagine</label>
                            <input type="url" class="form-control" id="menu-item-image" 
                                placeholder="https://esempio.com/immagine.jpg">
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Lascia vuoto per usare l'immagine predefinita.
                            </small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-2"></i>Annulla
                    </button>
                    <button type="button" class="btn btn-primary" onclick="saveMenuItem()">
                        <i class="bi bi-check-circle me-2"></i>Salva Piatto
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <%- include('partials/footer') %>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/javascripts/client.js"></script>
    <script src="/javascripts/dashboard.js"></script>
</body>
</html>